// 게이트웨이 (gateway) — 인터넷 되는 1대가 "자기 수집 + 폐쇄망 에이전트 중계"를 겸함.
//   수신: 메트릭 :9999 (prometheus remote_write), 로그 :9998 (loki push)
//   전달: 중앙 VictoriaMetrics(8428) / VictoriaLogs(9428)
// 환경변수:
//   RESOURCE_NAME  = 이 게이트웨이 서버 이름 (= 대시보드 사이트)
//   CENTRAL_VM_URL = http://<중앙>:8428/api/v1/write
//   CENTRAL_VL_URL = http://<중앙>:9428/insert/loki/api/v1/push

// ── 이 서버 자신도 수집 (게이트웨이도 결국 '직접' 서버) ──
//   에이전트 종류는 2가지: ⓐ 직접(인터넷O — 이 게이트웨이 포함) / ⓑ 폐쇄망(인터넷X, closed.alloy)
prometheus.exporter.unix "self" { }
prometheus.scrape "self" {
  targets         = prometheus.exporter.unix.self.targets
  forward_to      = [prometheus.relabel.self.receiver]
  scrape_interval = "15s"
}
prometheus.relabel "self" {
  forward_to = [prometheus.remote_write.central.receiver]
  rule {
    target_label = "host"
    replacement  = sys.env("RESOURCE_NAME")   // 이 중계 서버 자신의 이름
  }
}

// ── 이 서버 자신의 로그도 수집 → 중앙 ──
local.file_match "self_logs" {
  path_targets = [{ "__path__" = "/var/log/**/*.log" }]
}
loki.source.file "self_logs" {
  targets    = local.file_match.self_logs.targets
  forward_to = [loki.process.self_logs.receiver]
}
loki.process "self_logs" {
  forward_to = [loki.write.central.receiver]
  stage.static_labels {
    values = { host = sys.env("RESOURCE_NAME"), job = "syslog" }
  }
}

// ── (relay) 내부 agent 메트릭 수신 → 중앙 전달 ──
prometheus.receive_http "in" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9999
  }
  forward_to = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
  endpoint { url = sys.env("CENTRAL_VM_URL") }
}

// ── 로그 수신 → 중앙 전달 ──
loki.source.api "in" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 9998
  }
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint { url = sys.env("CENTRAL_VL_URL") }
}
