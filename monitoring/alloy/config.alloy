// 직접 에이전트 (config.alloy) — 인터넷 되는 일반 Linux 서버. 중앙으로 직접 전송.
//
// 핵심 원칙: 앱별 로그 경로를 받지 않는다. 중앙 싱크(journald) + 표준 위치(/var/log)만 잡는다.
//   - systemd 서비스 stdout/stderr → journald 자동 → 경로 불필요
//   - nginx/mysql 등 표준 위치 → /var/log glob 일괄
//   - 비표준 경로 앱만 예외적으로 path 추가(opt-in)
//   - 컨테이너 호스트는 config.docker.alloy 를 같은 디렉토리에 추가(드롭인)
//
// ⚠ host 라벨(RESOURCE_NAME) = 대시보드 사이트 = 알람 host. 일치시킬 것.
// ⚠ journald/varlog 접근 위해 Alloy는 호스트 패키지(systemd)로 실행 권장.
//
// 환경변수:
//   RESOURCE_NAME   예: web
//   CENTRAL_VM_URL  https://tbit-msp.kro.kr/vm/api/v1/write          (TLS 인제스트)
//   CENTRAL_VL_URL  https://tbit-msp.kro.kr/vl/insert/loki/api/v1/push
//   INGEST_USER / INGEST_PASS   nginx basic-auth 자격 (TLS 인제스트 보호)

// ========== 메트릭 (호스트 시스템 지표) ==========
prometheus.exporter.unix "host" { }

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.relabel.add_host.receiver]
  scrape_interval = "15s"
}

prometheus.relabel "add_host" {
  forward_to = [prometheus.remote_write.central.receiver]
  rule {
    target_label = "host"
    replacement  = sys.env("RESOURCE_NAME")
  }
}

prometheus.remote_write "central" {
  endpoint {
    url = sys.env("CENTRAL_VM_URL")
    basic_auth {
      username = sys.env("INGEST_USER")
      password = sys.env("INGEST_PASS")
    }
  }
}

// ========== 로그 1: journald (systemd 서비스 + 시스템 로그 전체) ==========
loki.source.journal "system" {
  max_age    = "12h"
  labels     = { job = "journal" }
  forward_to = [loki.process.add_host.receiver]
}

// ========== 로그 2: 표준 위치 파일 일괄 (앱 경로 몰라도 됨) ==========
local.file_match "varlog" {
  path_targets = [{ "__path__" = "/var/log/**/*.log" }]
}

loki.source.file "varlog" {
  targets    = local.file_match.varlog.targets
  forward_to = [loki.process.add_host.receiver]
}

// ========== 공통: host 라벨(resource_name) 부착 후 중앙 전송 ==========
// (config.docker.alloy 의 docker 로그도 이 add_host 로 합류)
loki.process "add_host" {
  forward_to = [loki.write.central.receiver]
  stage.static_labels {
    values = { host = sys.env("RESOURCE_NAME") }
  }
}

loki.write "central" {
  endpoint {
    url = sys.env("CENTRAL_VL_URL")
    basic_auth {
      username = sys.env("INGEST_USER")
      password = sys.env("INGEST_PASS")
    }
  }
}
