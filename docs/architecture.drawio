<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="air-arch" name="에이전트 기반 장애대응 — 올인원">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AI 장애대응 — 에이전트 기반 올인원 (확정 2026-06-04, 라이브 실증)" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="30" as="geometry" />
        </mxCell>

        <!-- 고객/테스트 호스트 -->
        <mxCell id="custLabel" value="모니터링 대상 호스트 (멀티클라우드: NCP/AWS/KT/온프렘, 윈도우/리눅스)" style="text;html=1;align=left;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hostA" value="서버 A (인터넷 가능)&#10;Grafana Alloy (direct)&#10;메트릭 + 로그 상시 push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hostB" value="서버 B (폐쇄망)&#10;Alloy (relay-agent) → relay-server&#10;메트릭 + 로그" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- 올인원 박스 -->
        <mxCell id="box" value="tbit-air-pub — 올인원 단일 서버 (docker compose, 전부 localhost 통신 / 향후 k8s 멀티 pod)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#9673a6;dashed=1;fontStyle=1;fontColor=#6c3483;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="760" height="560" as="geometry" />
        </mxCell>

        <!-- ingress -->
        <mxCell id="nginx" value="nginx (공인 80/443)&#10;/ → 분석 대시보드&#10;LE TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ingest" value="에이전트 인입 (ACG 소스IP 제한)&#10;VictoriaMetrics :8428 (메트릭)&#10;VictoriaLogs :9428 (로그)&#10;⚠ 무인증 → 사설/IP제한" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- 저장소 -->
        <mxCell id="vm" value="VictoriaMetrics (메트릭 TSDB, 3개월)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="240" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="vl" value="VictoriaLogs (로그, 7일 롤링)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="300" width="250" height="40" as="geometry" />
        </mxCell>

        <!-- 알람 -->
        <mxCell id="vmalert" value="vmalert (host.rules: CPU&gt;80%/Mem/Disk/Down)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="370" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="am" value="Alertmanager (dedup/그룹핑 → webhook)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="650" y="430" width="250" height="40" as="geometry" />
        </mxCell>

        <!-- 분석앱 -->
        <mxCell id="app" value="분석앱 (FastAPI)&#10;POST /webhook/alert&#10;→ victorialogs_collector(host 직전5분 pull)&#10;→ claude 분석 → incident DB&#10;→ 웹 대시보드 + 이메일" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="940" y="240" width="160" height="230" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="push 메트릭+로그" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="hostA" target="ingest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="(relay 경유)" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="hostB" target="ingest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="메트릭" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="ingest" target="vm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="로그" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="ingest" target="vl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="평가" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="vm" target="vmalert"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="발화" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="vmalert" target="am"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="① /webhook/alert" style="endArrow=block;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="am" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="② 직전5분 pull" style="endArrow=block;html=1;fontSize=10;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="app" target="vl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="대시보드" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="nginx" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="제거됨(NCP 종속): OBS · Cloud Function · NAT GW · Cloud Insight · CLA — 분석앱이 중앙 VictoriaLogs를 직접 pull(OBS/CF 없음). SPOF는 향후 k8s로 해소." style="text;html=1;align=left;fontSize=11;fontColor=#999999;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="900" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
