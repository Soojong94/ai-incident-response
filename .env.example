# AI API - Timely GPT (Native)
AI_API_KEY=tgpt_sk_your_key_here
AI_BASE_URL=https://hello.timelygpt.co.kr/api/v2/chat
AI_MODEL=gpt-5.1

# Database
DATABASE_URL=sqlite:///./incidents.db

# Webhook 인증 토큰 — 설정 시 /webhook/alert 에 `Authorization: Bearer <token>` 필수.
# 생성: python -c "import secrets; print(secrets.token_hex(24))"
# Alertmanager webhook_configs.http_config.authorization.credentials 에 같은 값 사용.
WEBHOOK_SECRET=

# VictoriaLogs (에이전트 기반 — 알람 시 host 직전 N분 로그 pull)
# 운영: 같은 사설 subnet의 monitoring_msp VictoriaLogs 사설 IP (무인증 → 공인 노출 금지)
VICTORIALOGS_URL=http://localhost:9428
LOG_WINDOW_SECONDS=300

# ── Auth ───────────────────────────────────────────────────────────────────
# SESSION_SECRET: 운영 배포 시 반드시 임의 32바이트 이상으로 교체.
#   생성 예시: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string
# HTTPS 환경에서만 쿠키 전송 (운영 True 권장, 로컬 http 개발은 False)
SESSION_COOKIE_SECURE=false
# 세션 유효 시간 (초) — 기본 8시간
SESSION_MAX_AGE_SECONDS=28800
# 비밀번호 최소 길이 (회원 생성/변경 시 강제)
MIN_PASSWORD_LENGTH=8

# 초기 관리자 계정 (서버 첫 기동 시 자동 생성 — 이후 admin UI에서 변경 권장)
# 운영 배포 후엔 .env에서 비밀번호를 비워두거나 변경.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
