# AI API - Timely GPT (OpenAI 호환)
AI_API_KEY=tgpt_sk_your_key_here
AI_BASE_URL=https://hello.timelygpt.co.kr/api/v2/chat/bridge/openai
AI_MODEL=anthropic/claude-sonnet-4-6

# Claude API로 전환 시:
# AI_API_KEY=sk-ant-your_key_here
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MODEL=claude-sonnet-4-6

# Database
DATABASE_URL=sqlite:///./incidents.db

# Webhook HMAC (선택사항 - 없으면 검증 생략)
WEBHOOK_SECRET=

# NCP (추후 추가)
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_REGION=KR
